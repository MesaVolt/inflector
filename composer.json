{
    "name": "mesavolt/inflector",
    "description": "Easy-to-use French plural generator",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MesaVolt",
            "email": "contact@mesavolt.com"
        }
    ],
    "autoload" : {
        "psr-4" : {
            "MesaVolt\\" : "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MesaVolt\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "twig/twig": "Required to use the MesaVolt\\Twig\\InflectorExtension Twig filter (^3)"
    },
    "require-dev": {
        "php-coveralls/php-coveralls": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.4",
        "twig/twig": "^3"
    }
}
